<section class="contact-section py-5" id="contact">
	<div class="container">
		<div class="text-center mb-5">
			<span class="section-subtitle"> GET IN TOUCH </span>
			<h2 class="section-title mt-3">We'd Love To Hear From You</h2>
			<p class="section-desc">Have questions, suggestions or
				partnership ideas? Send us a message and we'll respond as soon as possible.</p>
		</div>

		<div class="row align-items-center">

			<!-- Contact Form -->
			<div class="col-lg-7 mb-4">
				<div class="contact-card" data-aos="fade-left">
					<form>
						<div class="form-row">
							<div class="form-group col-md-6">
								<input type="text" class="form-control custom-input" placeholder="Your Name">
							</div>

							<div class="form-group col-md-6">
								<input type="email" class="form-control custom-input" placeholder="Email Address">
							</div>
						</div>

						<div class="form-group">
							<input type="text" class="form-control custom-input" placeholder="Subject">
						</div>

						<div class="form-group">
							<textarea rows="6" class="form-control custom-input" placeholder="Your Message"></textarea>
						</div>

						<button class="btn send-btn">
							<i class="fas fa-paper-plane mr-2"></i> Send Message
						</button>
					</form>
				</div>
			</div>

			<!-- Contact Details -->
			<div class="col-lg-5">
				<div class="contact-info" data-aos="fade-right">
					<div class="info-box">
						<i class="fas fa-map-marker-alt"></i>
						<div>
							<h5>Location</h5>
							<p>Hyderabad, India</p>
						</div>
					</div>

					<div class="info-box">
						<i class="fas fa-envelope"></i>
						<div>
							<h5>Email</h5>
							<p>support@tunewave.com</p>
						</div>
					</div>

					<div class="info-box">
						<i class="fas fa-phone"></i>
						<div>
							<h5>Phone</h5>
							<p>+91 98765 43210</p>
						</div>
					</div>

					<div class="info-box">
						<i class="fas fa-clock"></i>
						<div>
							<h5>Working Hours</h5>
							<p>Mon - Sat : 9 AM - 6 PM</p>
						</div>
					</div>

					<div class="social-icons mt-4">
						<a href="#"> <i class="fab fa-facebook-f"></i> </a> 
						<a href="#"> <i class="fab fa-instagram"></i> </a> 
						<a href="#"> <i class="fab fa-twitter"></i> </a> 
						<a href="#"> <i class="fab fa-linkedin-in"></i> </a>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>